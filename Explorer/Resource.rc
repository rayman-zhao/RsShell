// UTF-8 源（含中文 STRINGTABLE），rc 须显式声明代码页
#pragma code_page(65001)

#include <windows.h>
#include "ResourceIds.h"
#include "Version.h"

IDI_APP ICON "Explorer.ico"

// 换应用只改本文件。菜单文案按语言写全句（产品名可按语言不同）；
// AppId（= 消费方清单 <Application Id>，AUMID 尾段）两表同值——LoadString 无跨语言
// 回退，zh 线程命中 zh 表后同区块缺 ID 即失败
LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US
STRINGTABLE
BEGIN
    IDS_CMD_TITLE "Open in Motic DSAssistant Evo"
    IDS_TARGET_APP_ID "Ruslan"
END

LANGUAGE LANG_CHINESE, SUBLANG_CHINESE_SIMPLIFIED
STRINGTABLE
BEGIN
    IDS_CMD_TITLE "用 Motic DSAssistant Evo 打开"
    IDS_TARGET_APP_ID "Ruslan"
END

1 VERSIONINFO
FILEVERSION RSSHELL_VERSION_MAJOR, RSSHELL_VERSION_MINOR, RSSHELL_VERSION_BUILD, 0
PRODUCTVERSION RSSHELL_VERSION_MAJOR, RSSHELL_VERSION_MINOR, RSSHELL_VERSION_BUILD, 0
FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
FILEFLAGS 0x1L
#else
FILEFLAGS 0x0L
#endif
FILEOS 0x40004L
FILETYPE 0x2L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Swift Works"
            VALUE "FileDescription", "RsShell Explorer Context Menu"
            VALUE "FileVersion", RSSHELL_VERSION_STRING
            VALUE "InternalName", "RsShell.Explorer.dll"
            VALUE "OriginalFilename", "RsShell.Explorer.dll"
            VALUE "ProductName", "RsShell"
            VALUE "ProductVersion", RSSHELL_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
